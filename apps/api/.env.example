# ============================================================================
# MatchDay Social API — Environment Variables
# ============================================================================

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matchday_social?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# Google Maps API
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:19006"

# Sentry (Crash Reporting) — leave empty to disable
SENTRY_DSN=

# Email (Resend) — leave RESEND_API_KEY empty to disable email sending (graceful no-op)
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"
APP_RESET_URL_BASE="https://matchday.app"
