# @matchday/web — server-side env vars
# Copy to .env.local for local dev; production values live in Vercel project settings.

# Upstream API base URL — used by BFF route handlers + RSC server-side fetches.
# Local dev: point at local apps/api (which listens on :3000 by default).
# Production: https://api.matchday.app
API_BASE_URL=http://localhost:3000

# Public site URL — used for canonical links + Open Graph metadata.
# Local dev: web runs on :3001 (see scripts.dev in package.json).
# Production: https://matchday.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001
