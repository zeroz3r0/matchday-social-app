# @matchday/web — server-side env vars
# Copy to .env.local for local dev; production values live in Vercel project settings.

# Upstream API base URL — used by BFF route handlers (/api/auth/*, /api/users/me)
# and any RSC server-side fetches. Read by `apps/web/lib/api-client.ts#apiFetch`.
#
# - Local dev: point at the local apps/api (listens on :3000 by default — see
#   apps/api/src/server.ts:9). Run `npm run dev:api` in one terminal and
#   `npm run web:dev` in another.
# - Production: set to `https://api.matchday.app` in the Vercel project env
#   ONCE Phase 2 deploy lands. Phase 3 was implemented out of order against
#   localhost; the only thing that changes for prod is the value of this var.
#
# Trailing slashes are trimmed defensively by `apiFetch`, but please don't
# include one — it's a smell.
API_BASE_URL=http://localhost:3000

# Public site URL — used for canonical links + Open Graph metadata.
# Local dev: web runs on :3001 (see scripts.dev in package.json).
# Production: https://matchday.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001
