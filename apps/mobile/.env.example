# Copia este archivo como `.env` y ajusta los valores.

# "true" = usa mockApi con datos in-memory (offline, sin backend).
# "false" = llama al backend real.
EXPO_PUBLIC_USE_MOCK=true

# URL del backend — solo se usa si EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Sentry DSN — vacío = init no-op (crash reporting deshabilitado)
EXPO_PUBLIC_SENTRY_DSN=
