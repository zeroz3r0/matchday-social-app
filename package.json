{
  "name": "matchday-social-app",
  "version": "0.1.0",
  "private": true,
  "description": "Red social deportiva para gestionar partidos, ligas y torneos de futbol amateur",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w apps/api",
    "api:build": "npm run build -w apps/api",
    "api:start": "npm run start -w apps/api",
    "api:db:migrate": "npm run db:migrate -w apps/api",
    "api:db:seed": "npm run db:seed -w apps/api",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "shared:build": "npm run build -w packages/shared",
    "web:dev": "npm run shared:build && npm run dev -w @matchday/web",
    "web:build": "npm run shared:build && npm run build -w @matchday/web",
    "web:start": "npm run start -w @matchday/web",
    "web:test": "npm run test -w @matchday/web",
    "web:lint": "npm run lint -w @matchday/web",
    "web:typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "npm run test -w packages/shared && npm run test -w apps/api",
    "test:shared": "npm run test -w packages/shared",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w @matchday/web",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "clean": "rimraf apps/*/dist apps/*/node_modules packages/*/dist packages/*/node_modules node_modules"
  },
  "overrides": {
    "svix": "^1.92.2",
    "xcode": {
      "uuid": "^14"
    },
    "postcss@<8.5.10": "^8.5.10"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
